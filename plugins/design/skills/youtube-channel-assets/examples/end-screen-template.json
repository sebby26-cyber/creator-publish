{
 "version": 1,
 "name": "youtube-end-screen-template",
 "description": "End-screen layout guide, 1920x1080 (16:9). The slots mark where to drag YouTube Studio's end-screen elements: video-1 (Video: best for viewer, most recent, or a chosen video), video-2 (a second video or a playlist) and subscribe. Studio draws the real elements and sets their final size; the slots are planning boxes, not official dimensions. Layers whose id starts with 'guide-' are the dashed slot outlines and labels: keep them for the review guide, set them to \"visible\": false to export a clean branded end card for the editor. Brand-neutral placeholder: swap colours, copy and handle for the project's brand inputs.",
 "canvas": { "width": 1920, "height": 1080, "background": { "type": "linear", "angle": 135, "stops": [ { "offset": 0, "color": "#1b2230" }, { "offset": 1, "color": "#0c1017" } ] } },
 "output": { "path": "end-screen-template-1920x1080.png" },
 "layers": [
  { "id": "kicker", "type": "text", "text": "WATCH NEXT", "font": { "family": "Inter", "weight": 700 }, "size": 34, "minSize": 24, "letterSpacing": 6, "color": "#ffc43d", "x": 160, "y": 200, "width": 700 },
  { "id": "headline", "type": "text", "text": "Keep going:\nthe next one\nis better.", "font": { "family": "Anton" }, "size": 120, "minSize": 70, "lineHeight": 1.02, "transform": "uppercase", "color": "#f6f4ef", "x": 160, "y": 270, "width": 720, "height": 360 },
  { "id": "handle", "type": "text", "text": "@channelhandle", "font": { "family": "Inter", "weight": 700 }, "size": 36, "minSize": 24, "color": "#d7dbe3", "valign": "middle", "x": 160, "y": 760, "width": 360, "height": 60 },
  { "id": "guide-video-1", "type": "shape", "shape": "rect", "x": 1000, "y": 170, "width": 760, "height": 428, "radius": 12, "fill": "rgba(255,255,255,0.06)", "stroke": { "color": "#9aa3b2", "width": 4, "dash": [18, 10] } },
  { "id": "guide-video-1-label", "type": "text", "text": "VIDEO 1: BEST FOR VIEWER", "font": { "family": "Inter", "weight": 700 }, "size": 30, "letterSpacing": 3, "color": "#d7dbe3", "align": "center", "valign": "middle", "x": 1000, "y": 170, "width": 760, "height": 428 },
  { "id": "guide-video-2", "type": "shape", "shape": "rect", "x": 1000, "y": 640, "width": 512, "height": 288, "radius": 12, "fill": "rgba(255,255,255,0.06)", "stroke": { "color": "#9aa3b2", "width": 4, "dash": [18, 10] } },
  { "id": "guide-video-2-label", "type": "text", "text": "VIDEO 2 / PLAYLIST", "font": { "family": "Inter", "weight": 700 }, "size": 28, "letterSpacing": 3, "color": "#d7dbe3", "align": "center", "valign": "middle", "x": 1000, "y": 640, "width": 512, "height": 288 },
  { "id": "guide-subscribe", "type": "shape", "shape": "circle", "x": 560, "y": 690, "width": 200, "height": 200, "fill": "rgba(255,255,255,0.06)", "stroke": { "color": "#9aa3b2", "width": 4, "dash": [14, 8] } },
  { "id": "guide-subscribe-label", "type": "text", "text": "SUBSCRIBE", "font": { "family": "Inter", "weight": 700 }, "size": 24, "letterSpacing": 2, "color": "#d7dbe3", "align": "center", "valign": "middle", "x": 560, "y": 690, "width": 200, "height": 200 }
 ]
}
