# Normalize text files to LF in the repo
* text=auto eol=lf

# Binary assets: never touch line endings or diff them as text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Upstream licence texts are kept byte-for-byte as shipped
plugins/compose/renderer/fonts/*.txt -text
